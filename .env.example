# Copy to .env. None of these are secrets.
WXT_TARGET_BROWSER=chrome
WXT_RENDER_ENGINE=typst
WXT_DEFAULT_BASE_URL=https://api.groq.com/openai/v1
WXT_DEFAULT_FAST_MODEL=openai/gpt-oss-20b
WXT_DEFAULT_STRONG_MODEL=openai/gpt-oss-120b
WXT_GITHUB_API_BASE=https://api.github.com
WXT_LOG_LEVEL=warn
WXT_FEATURE_ON_DEVICE_MODEL=false
# Only for running the evaluation against a real provider. Never bundled.
EVAL_PROVIDER_KEY=
